<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================== Audio (PTT / VOX) ===================== -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ===================== Bluetooth LE ===================== -->
    <!-- API 31+ (Android 12+): granular Bluetooth runtime permissions.
         neverForLocation on SCAN because we derive proximity from RSSI +
         BeaconPacket contents, not from BLE-inferred location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="31" />

    <!-- API 28-30: legacy Bluetooth permissions + the location permission
         BLE scanning requires on those levels. AndroidBleScanner picks
         between this pair and the API 31+ set above at runtime. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <!-- Declares BLE as used-but-not-required: many tactical radios/relays
         are phones without native BLE, but we don't gate install on it. -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- ===================== Wi-Fi Direct ===================== -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- API 33+ replacement for ACCESS_FINE_LOCATION as the Wi-Fi Direct
         peer-discovery gate. ACCESS_FINE_LOCATION above (maxSdkVersion=32)
         still covers API 28-32 for this same purpose. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" tools:targetApi="33" />

    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />

    <!-- ===================== Flashlight / Camera torch ===================== -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <!-- ===================== Haptics ===================== -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ===================== Power ===================== -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ===================== Notifications (API 33+) ===================== -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ===================== Mesh relay foreground service ===================== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- ===================== Alarm bypass (DND override) ===================== -->
    <!-- Special-access permission — not grantable via a runtime request
         dialog like the others above. AndroidAlarmBypass checks
         isNotificationPolicyAccessGranted and no-ops the DND portion
         (still maxes volume) if the user hasn't separately granted this
         via Settings.ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS — that
         settings-screen deep link isn't built anywhere yet. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application>
        <!--
          TODO(open item): the actual mesh-relay foreground Service class
          isn't among platform-android's files per architecture.md — it
          isn't listed under engine-mesh's tree either (not yet seen).
          Once that class exists, declare it here, e.g.:

          <service
              android:name="<fully-qualified-class>"
              android:foregroundServiceType="connectedDevice"
              android:exported="false" />

          Flag for whoever owns engine-mesh / app: where does this
          Service live, and does app/AndroidManifest.xml expect to
          declare it itself instead of it living in this module?
        -->
    </application>

</manifest>